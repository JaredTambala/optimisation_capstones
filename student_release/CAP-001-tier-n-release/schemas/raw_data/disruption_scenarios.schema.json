{
  "$id": "https://capstones.internal/schemas/disruption_scenarios.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Controlled BASE and five disruption scenarios.",
  "items": {
    "additionalProperties": false,
    "properties": {
      "active_flag": {
        "description": "Available in the release.",
        "type": "boolean"
      },
      "description": {
        "description": "Customer-facing narrative.",
        "minLength": 1,
        "type": "string"
      },
      "recommended_run_mode": {
        "description": "Source guidance; STRESS_ONLY is optional and does not constrain application behaviour.",
        "enum": [
          "STRESS_ONLY",
          "REOPTIMISE",
          "BOTH"
        ],
        "type": "string"
      },
      "scenario_category": {
        "description": "Scenario family.",
        "enum": [
          "BASE",
          "SOURCE",
          "LOGISTICS",
          "NODE",
          "REGIONAL",
          "COMBINED"
        ],
        "type": "string"
      },
      "scenario_id": {
        "description": "Source-package condition identifier; supplied values are examples, not a closed domain.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
        "type": "string"
      },
      "scenario_name": {
        "description": "Human-readable scenario name.",
        "minLength": 1,
        "type": "string"
      },
      "severity": {
        "description": "Qualitative severity.",
        "enum": [
          "NORMAL",
          "MODERATE",
          "HIGH",
          "SEVERE"
        ],
        "type": "string"
      }
    },
    "required": [
      "scenario_id",
      "scenario_name",
      "scenario_category",
      "severity",
      "description",
      "recommended_run_mode",
      "active_flag"
    ],
    "type": "object"
  },
  "title": "disruption_scenarios",
  "type": "array"
}
