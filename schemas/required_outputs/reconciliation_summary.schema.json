{
  "$id": "https://capstones.internal/schemas/reconciliation_summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Run-level reconciliation summary.",
  "properties": {
    "failed_checks": {
      "minimum": 0,
      "type": "integer"
    },
    "maximum_bound_violation": {
      "minimum": 0,
      "type": "number"
    },
    "maximum_integrality_residual": {
      "minimum": 0,
      "type": "number"
    },
    "maximum_quantity_residual": {
      "minimum": 0,
      "type": "number"
    },
    "maximum_unit_cost_residual_eur_per_unit": {
      "minimum": 0,
      "type": "number"
    },
    "maximum_value_residual_eur": {
      "minimum": 0,
      "type": "number"
    },
    "quantity_checks": {
      "minimum": 0,
      "type": "integer"
    },
    "reconciliation_pass_flag": {
      "type": "boolean"
    },
    "run_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "unit_cost_checks": {
      "minimum": 0,
      "type": "integer"
    },
    "value_checks": {
      "minimum": 0,
      "type": "integer"
    }
