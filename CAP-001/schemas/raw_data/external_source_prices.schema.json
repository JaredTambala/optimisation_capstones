{
  "$id": "https://capstones.internal/schemas/external_source_prices.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "External unit prices for eligible boundary contracts only.",
  "items": {
    "additionalProperties": false,
    "properties": {
      "contract_id": {
        "description": "Boundary-source external-price contract.",
        "pattern": "^CTR-[0-9]{5}$",
        "type": "string"
      },
      "currency": {
        "description": "Price currency.",
        "pattern": "^[A-Z]{3}$",
        "type": "string"
      },
      "material_id": {
        "description": "External-price-eligible material.",
        "pattern": "^MAT-[0-9]{4}$",
        "type": "string"
      },
      "period_id": {
        "description": "Dispatch period.",
        "pattern": "^P(0[1-9]|1[0-2])$",
        "type": "string"
      },
      "price_source": {
        "const": "SYNTHETIC_FIXED",
        "description": "Synthetic source marker.",
        "type": "string"
      },
      "scenario_sensitive_flag": {
        "description": "Whether configured price impacts may apply.",
        "type": "boolean"
      },
      "unit_price": {
        "description": "Authoritative boundary price.",
        "exclusiveMinimum": 0,
        "type": "number"
      }
    },
    "required": [
      "contract_id",
      "material_id",
      "period_id",
      "unit_price",
      "currency",
      "price_source",
      "scenario_sensitive_flag"
    ],
    "type": "object"
  },
  "title": "external_source_prices",
  "type": "array"
}
