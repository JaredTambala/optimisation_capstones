{
  "$id": "https://capstones.internal/schemas/release_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "configuration_version": {
      "type": "string"
    },
    "data_contract_version": {
      "type": "string"
    },
    "dataset_package_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 6,
      "type": "array",
      "uniqueItems": true
    },
    "dataset_packages": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "file_count": {
            "minimum": 25,
            "type": "integer"
          },
          "manifest_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "row_count": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "manifest_sha256",
          "file_count",
          "row_count"
        ],
        "type": "object"
      },
      "type": "object"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "release_id": {
      "type": "string"
    },
    "release_version": {
      "type": "string"
    },
    "rubric_version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "release_id",
    "release_version",
    "configuration_version",
    "data_contract_version",
    "schema_version",
    "rubric_version",
    "dataset_package_ids",
    "files",
    "dataset_packages"
  ],
  "title": "CAP-001 release manifest",
  "type": "object"
}
