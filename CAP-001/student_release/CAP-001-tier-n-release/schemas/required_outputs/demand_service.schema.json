{
  "$id": "https://capstones.internal/schemas/demand_service.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Plant-terminal-material-period demand and service.",
  "items": {
    "additionalProperties": false,
    "properties": {
      "dataset_version_id": {
        "type": "string"
      },
      "demand_quantity": {
        "minimum": 0,
        "type": "number"
      },
      "material_id": {
        "type": "string"
      },
      "period_id": {
        "type": "string"
      },
      "plant_id": {
        "type": "string"
      },
      "run_id": {
        "type": "string"
      },
      "served_quantity": {
        "minimum": 0,
        "type": "number"
      },
      "served_value_eur": {
        "minimum": 0,
        "type": "number"
      },
      "shortage_quantity": {
        "minimum": 0,
        "type": "number"
      },
      "unit_cost_eur": {
        "minimum": 0,
        "type": "number"
      }
